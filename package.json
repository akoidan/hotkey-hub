{
  "name": "hotkey-hub",
  "version": "2.0.1",
  "main": "src/index.js",
  "repository": "git@github.com:akoidan/hotkey-hub.git",
  "author": "akoidan <deathangel908@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "rm -rf ./dist/ && node -r tsconfig-paths/register -r ts-node/register src/main.ts",
    "cmake": "cmake-js build",
    "cmake:debug": "cmake-js build --debug",
    "nest": "nest build",
    "native": "pkg .",
    "build": "npm-run-all -s cmake nest native",
    "test": "jest --coverage  --detectOpenHandles --testTimeout=10000",
    "schema:json": "node -r tsconfig-paths/register -r ts-node/register src/config/generate-schema.ts",
    "schema:doc": "ts-node src/config/zod2md.ts",
    "rgb": "rm -rf ./dist/ && node -r tsconfig-paths/register -r ts-node/register src/rgb-test.ts",
    "clean": "rm -rf ./dist/ && rm -rf ./build",
    "lint": "eslint --ext .ts --max-warnings=0 src",
    "autoformat": "eslint --ext .ts --max-warnings=0 --fix src",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^11.0.3",
    "@types/bindings": "^1.5.5",
    "@types/cli-color": "^2.0.6",
    "@types/jest": "^29.5.14",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^7.7.2",
    "@typescript-eslint/parser": "^7.7.2",
    "cmake-js": "^7.3.0",
    "eslint": "^8.57.0",
    "eslint-find-rules": "^4.1.0",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-sonarjs": "^0.25.1",
    "eslint-plugin-unicorn": "^56.0.0",
    "jest": "^29.7.0",
    "node-addon-api": "^8.3.0",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.0",
    "pkg": "^5.8.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5",
    "zod2md": "0.2.5"
  },
  "engines": {
    "node": ">=18.0.0 <19",
    "npm": "please-use-yarn",
    "yarn": ">= 1.17.3"
  },
  "pkg": {
    "scripts": "dist/main.js",
    "assets": [
      "node_modules/thread-stream/lib/worker.js",
      "build/Release/server.node",
      "build/Debug/server.node"
    ],
    "targets": [
      "host"
    ]
  },
  "binary": {
    "napi_versions": [
      8
    ]
  },
  "bin": "dist/main.js",
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^11.1.13",
    "bindings": "^1.5.0",
    "cli-color": "^2.0.4",
    "jsonc-parser": "^3.3.1",
    "openrgb-sdk": "^0.5.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "7.1.0",
    "yargs": "^17.7.2",
    "zod": "^4.3.5"
  }
}
