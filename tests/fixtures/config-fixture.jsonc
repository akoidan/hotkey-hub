{
  "ips": {
    "this": "127.0.0.1",
    "that": "127.0.0.2",
    "other": "127.0.0.3"
  },
  "macros": {
    "tyr": {
      "commands": [
        {
          "assignVariable": "tyrIndex",
          "expression": "(tyrIndex+1) % 2"
        },
        {
          "assignVariable": "pctyr",
          "expression": "pctyrs[tyrIndex]"
        },
        {
          "destination": {
            "$ref": "pctyr"
          },
          "performOnRemote": "keyPress",
          "variables": {
            "key": {
              "$ref": "keyPress"
            }
          }
        }
      ],
      "variables": {
        "keyPress": {
          "type": "string"
        }
      }
    },
    "keyPress": {
      "commands": [
        {
          "transaction": {
            "$ref": "destination"
          },
          "commands": [
            {
              "destination": {
                "$ref": "destination"
              },
              "performOnRemote": "focusWindow",
              "variables": {
                "wid": {
                  "$ref": "focusWid"
                }
              }
            },
            {
              "destination": {
                "$ref": "destination"
              },
              "delayAfter": 50,
              "performOnRemote": "keyPress",
              "variables": {
                "key": {
                  "$ref": "keyPress"
                }
              }
            }
          ]
        }
      ],
      "variables": {
        "destination": {
          "type": "string"
        },
        "focusWid": {
          "type": "number"
        },
        "keyPress": {
          "type": "string"
        }
      }
    },
    "typeLoginPassword": {
      "commands": [
        {
          "destination": {
            "$ref": "destination"
          },
          "performOnRemote": "typeText",
          "variables": {
            "text": {
              "$ref": "login"
            }
          }
        },
        {
          "destination": {
            "$ref": "destination"
          },
          "performOnRemote": "keyPress",
          "variables": {
            "key": "tab"
          }
        },
        {
          "destination": {
            "$ref": "destination"
          },
          "delayAfter": {
            "$ref": "delayAfter"
          },
          "performOnRemote": "keyPress",
          "variables": {
            "key": "enter"
          }
        }
      ],
      "variables": {
        "destination": {
          "type": "string"
        },
        "login": {
          "type": "string"
        },
        "delayAfter": {
          "type": "number"
        }
      }
    }
  },
  "combinations": [
    {
      "commands": [
        {
          "macro": "keyPress",
          "variables": {
            "focusWid": {
              "$ref": "widwc"
            },
            "destination": {
              "$ref": "pcwc"
            },
            "keyPress": "f4"
          }
        }
      ],
      "name": "Target me",
      "shortCut": "Alt+s"
    },
    {
      "name": "test1",
      "shortCut": "Alt+c",
      "commands": [
        {
          "destination": "this",
          "performOnRemote": "keyPress",
          "variables": {
            "key": "f6"
          }
        }
      ]
    },
    {
      "name": "Launch exe test",
      "shortCut": "Alt+F11",
      "commands": [
        {
          "destination": "this",
          "performOnRemote": "launchExe",
          "variables": {
            "path": "C:\\Windows\\System32\\shutdown.exe",
            "arguments": [
              "/s",
              "/t",
              "0"
            ]
          }
        }
      ]
    },
    {
      "name": "variable-test",
      "shortCut": "Alt+4",
      "commands": [
        {
          "destination": "this",
          "performOnRemote": "typeText",
          "variables": {
            "text": {
              "$ref": "login"
            }
          }
        }
      ]
    },
    {
      "commands": [
        {
          "macro": "tyr",
          "variables": {
            "keyPress": "f5"
          }
        }
      ],
      "name": "Stun",
      "shortCut": "Alt+1"
    },
    {
      "name": "macro-delay-test",
      "shortCut": "Alt+5",
      "commands": [
        {
          "macro": "typeLoginPassword",
          "variables": {
            "destination": "this",
            "login": "testuser",
            "delayAfter": 1000
          }
        }
      ]
    }
  ]
}