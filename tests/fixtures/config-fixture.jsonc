{
  "ips": {
    "this": "127.0.0.1",
    "that": "127.0.0.2",
    "other": "127.0.0.3"
  },
  "macros": {
    "tyr": {
      "commands": [
        {
          "assignVariable": "tyrIndex",
          "expression": "(tyrIndex+1) % 2"
        },
        {
          "assignVariable": "pctyr",
          "expression": "pctyrs[tyrIndex]"
        },
        {
          "destination": "{{pctyr}}",
          "keyPress": "{{keyPress}}"
        }
      ],
      "variables": {
        "keyPress": {
          "type": "string"
        }
      }
    },
    "keyPress": {
      "commands": [
        {
          "transaction": "{{destination}}",
          "commands": [
            {
              "destination": "{{destination}}",
              "focusWid": "{{focusWid}}"
            },
            {
              "destination": "{{destination}}",
              "keyPress": "{{keyPress}}",
              "delayAfter": 50
            }
          ]
        }
      ],
      "variables": {
        "destination": {
          "type": "string"
        },
        "focusWid": {
          "type": "number"
        },
        "keyPress": {
          "type": "string"
        }
      }
    },
    "loginProceed": {
      "commands": [
        {
          "destination": "{{destination}}",
          "typeText": "{{login}}"
        },
        {
          "destination": "{{destination}}",
          "keyPress": "tab"
        },
        {
          "destination": "{{destination}}",
          "keyPress": "enter",
          "delayAfter": "{{delayAfter}}"
        }
      ],
      "variables": {
        "destination": {
          "type": "string"
        },
        "login": {
          "type": "string"
        },
        "delayAfter": {
          "type": "number"
        }
      }
    }
  },
  "combinations": [
    {
      "commands": [
        {
          "macro": "keyPress",
          "variables": {
            "focusWid": "{{widwc}}",
            "destination": "{{pcwc}}",
            "keyPress": "f4"
          }
        }
      ],
      "name": "Target me",
      "shortCut": "Alt+s"
    },
    {
      "name": "test1",
      "shortCut": "Alt+c",
      "commands": [
        {
          "destination": "this",
          "keyPress": "f6"
        }
      ]
    },
    {
      "name": "Launch exe test",
      "shortCut": "Alt+F11",
      "commands": [
        {
          "destination": "this",
          "launch": "C:\\Windows\\System32\\shutdown.exe",
          "arguments": [
            "/s",
            "/t",
            "0"
          ]
        }
      ]
    },
    {
      "name": "variable-test",
      "shortCut": "Alt+4",
      "commands": [
        {
          "destination": "this",
          "typeText": "{{login}}"
        }
      ]
    },
    {
      "commands": [
        {
          "macro": "tyr",
          "variables": {
            "keyPress": "f5"
          }
        }
      ],
      "name": "Stun",
      "shortCut": "Alt+1"
    },
    {
      "name": "macro-delay-test",
      "shortCut": "Alt+5",
      "commands": [
        {
          "macro": "loginProceed",
          "variables": {
            "destination": "this",
            "login": "testuser",
            "delayAfter": 1000
          }
        }
      ]
    }
  ]
}
